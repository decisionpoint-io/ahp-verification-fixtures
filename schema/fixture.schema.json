{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/decisionpoint-io/ahp-verification-fixtures/schema/fixture.schema.json",
  "title": "AHP verification fixture",
  "description": "A judgment matrix (or set of matrices) with expected outputs, per-value provenance, and stated numeric tolerances.",
  "type": "object",
  "required": ["id", "title", "description", "category", "source", "expected"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable identifier; must match the file name (without .json)."
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["matrix", "hierarchy", "stability"],
      "description": "matrix: one or more standalone pairwise matrices. hierarchy: matrices linked parent-child with a synthesis. stability: a decision matrix with expected sensitivity/criticality outputs."
    },
    "source": {
      "type": "object",
      "required": ["citation"],
      "additionalProperties": false,
      "properties": {
        "citation": { "type": "string" },
        "url": { "type": "string" },
        "accessed": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "scale": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "fractional_values_allowed": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "ri_table": {
      "type": "object",
      "description": "The random-index table under which the expected CR values are stated. CR depends on it, so it is named and its values are inlined.",
      "required": ["name", "values", "source"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "enum": ["saaty", "alonso-lamata"] },
        "values": {
          "type": "object",
          "patternProperties": { "^[0-9]+$": { "type": "number" } },
          "additionalProperties": false
        },
        "source": { "type": "string" }
      }
    },
    "related_fixtures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "matrices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/matrixDef" }
    },
    "decision_matrix": {
      "type": "object",
      "description": "For category 'stability': criteria weights and a performance matrix (rows = alternatives, columns = criteria).",
      "required": ["criteria", "alternatives", "weights", "performance"],
      "additionalProperties": false,
      "properties": {
        "criteria": { "type": "array", "items": { "type": "string" } },
        "alternatives": { "type": "array", "items": { "type": "string" } },
        "weights": { "type": "array", "items": { "type": "number" } },
        "performance": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "number" } }
        },
        "notes": { "type": "string" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "matrices": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/matrixExpected" }
        },
        "global_priorities": { "$ref": "#/definitions/labelledExpected" },
        "synthesis": { "$ref": "#/definitions/labelledExpected" },
        "stability": {
          "type": "object",
          "description": "Expected sensitivity/criticality outputs. Structure follows the cited model; every value block carries tolerance and provenance.",
          "required": ["model"],
          "properties": { "model": { "type": "string" } }
        }
      }
    },
    "source_reported": {
      "type": "object",
      "description": "Values the source itself displays that are informational rather than normative here (for example, values produced by an unstated or approximate method, or entries that do not recompute from the published inputs). Always carries an explanation; never checked by runners.",
      "required": ["explanation", "values", "citation"],
      "additionalProperties": false,
      "properties": {
        "explanation": { "type": "string" },
        "values": { "type": "object" },
        "citation": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "category": { "const": "stability" } } },
      "then": { "required": ["decision_matrix"] },
      "else": { "required": ["matrices", "ri_table", "scale"] }
    }
  ],
  "definitions": {
    "entry": {
      "description": "A pairwise judgment: a number, or a fraction string such as \"1/3\".",
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(/[0-9]+(\\.[0-9]+)?)?$" }
      ]
    },
    "matrixDef": {
      "type": "object",
      "required": ["key", "labels", "rows"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "labels": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "array", "items": { "$ref": "#/definitions/entry" } }
        },
        "description": { "type": "string" },
        "parent": {
          "type": "object",
          "required": ["matrix", "element"],
          "additionalProperties": false,
          "properties": {
            "matrix": { "type": "string" },
            "element": { "type": "string" }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["computed-by-hand", "published", "derived"] },
        "citation": { "type": "string" },
        "method": { "type": "string" },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "published" } } },
          "then": { "required": ["citation"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["derived", "computed-by-hand"] } } },
          "then": { "required": ["method"] }
        }
      ]
    },
    "vectorExpected": {
      "type": "object",
      "required": ["values", "tolerance", "provenance"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string" },
        "values": { "type": "array", "items": { "type": "number" } },
        "tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "provenance": { "$ref": "#/definitions/provenance" },
        "note": { "type": "string" }
      }
    },
    "scalarExpected": {
      "type": "object",
      "required": ["value", "tolerance", "provenance"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "provenance": { "$ref": "#/definitions/provenance" },
        "note": { "type": "string" }
      }
    },
    "matrixExpected": {
      "type": "object",
      "required": ["priorities", "lambda_max", "ci", "cr"],
      "additionalProperties": false,
      "properties": {
        "priorities": { "$ref": "#/definitions/vectorExpected" },
        "lambda_max": { "$ref": "#/definitions/scalarExpected" },
        "ci": { "$ref": "#/definitions/scalarExpected" },
        "cr": { "$ref": "#/definitions/scalarExpected" },
        "alternates": {
          "type": "array",
          "description": "Expected outputs under alternative documented prioritization methods. A tool is checked against the block whose method matches the tool's documented method; divergence between blocks is a method difference, not an error.",
          "items": {
            "type": "object",
            "required": ["method", "provenance"],
            "additionalProperties": false,
            "properties": {
              "method": { "type": "string" },
              "priorities": {
                "type": "object",
                "required": ["values", "tolerance"],
                "additionalProperties": false,
                "properties": {
                  "values": { "type": "array", "items": { "type": "number" } },
                  "tolerance": { "type": "number", "exclusiveMinimum": 0 }
                }
              },
              "lambda_max": { "$ref": "#/definitions/alternateScalar" },
              "ci": { "$ref": "#/definitions/alternateScalar" },
              "cr": { "$ref": "#/definitions/alternateScalar" },
              "provenance": { "$ref": "#/definitions/provenance" }
            }
          }
        }
      }
    },
    "alternateScalar": {
      "type": "object",
      "required": ["value", "tolerance"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "tolerance": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "labelledExpected": {
      "type": "object",
      "required": ["labels", "values", "tolerance", "provenance"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "values": { "type": "array", "items": { "type": "number" } },
        "tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "provenance": { "$ref": "#/definitions/provenance" },
        "note": { "type": "string" },
        "alternates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["method", "values", "tolerance", "provenance"],
            "additionalProperties": false,
            "properties": {
              "method": { "type": "string" },
              "values": { "type": "array", "items": { "type": "number" } },
              "tolerance": { "type": "number", "exclusiveMinimum": 0 },
              "provenance": { "$ref": "#/definitions/provenance" }
            }
          }
        }
      }
    }
  }
}
